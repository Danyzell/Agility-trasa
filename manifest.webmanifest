{
 "name": "AgiPlan",
 "short_name": "AgiPlan",
 "description": "Plánovač agility parkurů: trasy, čtení plánků z fotky, trénink, stopky. Česky i anglicky.",
 "lang": "cs",
 "id": "./",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#f2f4ee",
 "theme_color": "#1f6b45",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "plan",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 }
}